# macOS 시스템 파일
.DS_Store

# Python 캐시 파일 — 바이트코드 컴파일 결과물 (git에 불필요)
__pycache__/
*.pyc

# 분석 결과 DB — 로컬 실행 시 생성되는 데이터 (환경마다 다름)
data/
.claude/

# 환경 변수 (민감정보 — ngrok 토큰, RabbitMQ 자격증명 등)
.env

# 매번 실행할 때 자동 생성/덮어쓰기되는 파일
# (학회 발표 baseline은 docs/에 별도 보관, eval/는 baseline + 회귀 평가용 보존)
/benchmark_results.json
/tmp/
